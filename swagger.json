  "paths": {
    "/": {
      "get": {
        "summary": "API welcome and available endpoints",
        "description": "Returns a welcome message and a list of available Star Wars API endpoints.",
        "responses": {
          "200": {
            "description": "API is running and available endpoints are listed",
            "content": {
              "application/json": {
                "example": {
                  "message": "Welcome to the Star Wars API",
                  "description": "This API provides access to Star Wars heroes and villains data.",
                  "endpoints": {
                    "heroes": "/api/heroes",
                    "villains": "/api/villains"
                  },
                  "docs": "/api-docs",
                  "status": "OK"
                }
              }
            }
          }
        }
      }
    },
    "/api/heroes/": {
      "get": {
        "summary": "Get all Star Wars heroes",
        "description": "Returns an array of all heroes stored in the database.",
        "responses": {
          "200": {
            "description": "List of heroes"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a new hero",
        "description": "Creates a new hero and returns the generated ID.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Contact data to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CharacterInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Hero created successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/heroes/{id}": {
      "get": {
        "summary": "Get Star Wars hero by ID",
        "description": "Returns a single hero by MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Hero ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Hero found"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Hero not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "description": "",
