{
  "swagger": "2.0",
  "info": {
    "title": "Star Wars API",
    "description": "Heroes and Villains REST API",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
