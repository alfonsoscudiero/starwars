###################################################
# STARWARS API - Local + Render demo (Heroes)
# Local base:  http://localhost:3000
# Render base: https://starwars-p3bg.onrender.com
###################################################

### Root (LOCAL)
GET http://localhost:3000/

### Root (RENDER)
GET https://starwars-p3bg.onrender.com/

### Get all heroes (LOCAL)
GET http://localhost:3000/api/heroes
Accept: application/json

### Get all heroes (RENDER)
GET https://starwars-p3bg.onrender.com/api/heroes
Accept: application/json

### Get hero by id (LOCAL)
GET http://localhost:3000/api/heroes/{HERO_ID}
Accept: application/json

### Get hero by id (RENDER)
GET https://starwars-p3bg.onrender.com/api/heroes/{HERO_ID}
Accept: application/json

### Create hero - Yoda (LOCAL)
POST http://localhost:3000/api/heroes
Content-Type: application/json
Accept: application/json

{
  "firstName": "Yoda",
  "lastName": null,
  "species": "Unknown",
  "role": "Grand Master",
  "homeWorld": "Unknown",
  "weapon": "Lightsaber",
  "powerLevel": 99
}

### Create hero - Yoda (RENDER)
POST https://starwars-p3bg.onrender.com/api/heroes
Content-Type: application/json
Accept: application/json

{
  "firstName": "Yoda",
  "lastName": null,
  "species": "Unknown",
  "role": "Grand Master",
  "homeWorld": "Unknown",
  "weapon": "Lightsaber",
  "powerLevel": 99
}

