<nav class="site-nav">
  <div class="site-nav-inner">

    <!-- Logo -->
    <a class="site-nav-logo" href="/" aria-label="Star Wars API Home">
      <img
        src="/img/logo/starwars-app-logo.webp"
        alt="Star Wars API Logo"
        width="50"
        height="50"
      >
    </a>

    <!-- Auth button -->
    <div class="site-nav-auth">
      <% if (!user) { %>
        <a href="/auth/github" class="btn btn-outline">
          Login
        </a>
      <% } else { %>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="btn btn-primary">
            Logout
          </button>
        </form>
      <% } %>
    </div>

  </div>
</nav>